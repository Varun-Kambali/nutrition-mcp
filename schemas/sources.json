{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sources",
  "description": "The sources.yaml file in a dataset folder: a list of sources.",
  "$defs": {
    "Source": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "license": {
          "title": "License",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        },
        "retrieved": {
          "format": "date",
          "title": "Retrieved",
          "type": "string"
        },
        "attribution": {
          "title": "Attribution",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "url",
        "license",
        "version",
        "retrieved",
        "attribution"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "items": {
    "$ref": "#/$defs/Source"
  },
  "type": "array"
}
