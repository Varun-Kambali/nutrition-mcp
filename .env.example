# Copy to .env and fill in. The real .env is git-ignored.

# USDA FoodData Central key, only needed by `make data` (free: https://fdc.nal.usda.gov/api-key-signup).
USDA_FDC_API_KEY=your-usda-key-here

# Gemini API key, only needed by `make eval` (free tier: https://aistudio.google.com/apikey).
GEMINI_API_KEY=your-gemini-key-here

# Model used by `make eval`.
EVAL_MODEL=gemini-3.1-flash-lite

# Server settings, all optional. The values below are the defaults.
# Extra dataset folders to load next to the bundled data, separated by ":" (";" on Windows).
# NUTRITION_MCP_DATA_DIRS=
# Grams in one katori when a dish does not define its own: above 0 and at most 1000.
# NUTRITION_MCP_DEFAULT_KATORI_G=150
# Log level for the JSON logs written to stderr: DEBUG, INFO, WARNING, ERROR or CRITICAL.
# NUTRITION_MCP_LOG_LEVEL=INFO
